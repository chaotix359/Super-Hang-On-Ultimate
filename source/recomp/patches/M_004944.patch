+ * callers (0x46E8 class loop, 0x4A42 music loop) add it to the selection and wrap with AND 3.
+ * Addition: gamepad stick/d-pad navigation supplies +1 / -1 (one per call; queued presses follow).
+ * Without gamepad navigation the routine is exactly the original. */
 #include "rc_runtime.h"
 #include "rc_overrides.h"
+
+extern int sho_menu_step;
+extern long sho_menu_last_frame, sho_frame_no;
+static void menu_pad_hook(void) {
+    sho_menu_last_frame = sho_frame_no;           /* tells the core a select screen is up */
+    if (sho_menu_step) {
+        m68k_write_memory_16(REG_A[2] + 2, sho_menu_step > 0 ? 0x0001 : 0xffff);
+        sho_menu_step += sho_menu_step > 0 ? -1 : 1;
+    }
+}
 
